{
  "name": "@weekndlabs/design",
  "version": "0.3.1",
  "description": "Design tokens for WeekndLabs products",
  "type": "module",
  "license": "MIT AND OFL-1.1",
  "files": [
    "dist",
    "tokens",
    "lib/typography.js",
    "README.md",
    "ABOUT.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./shadcn.css": "./dist/shadcn.css",
    "./fonts.css": "./dist/fonts.css",
    "./fonts/*": "./dist/fonts/*",
    "./tailwind": "./dist/tailwind.js",
    "./typography-check": "./lib/typography.js",
    ".": "./dist/tokens.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build/index.js",
    "prepublishOnly": "npm run build && npm test",
    "test": "node --test lib/*.test.js",
    "check:overflow": "node scripts/check-overflow.mjs",
    "docs:dev": "astro dev --root docs",
    "docs:build": "astro build --root docs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "style-dictionary": "^5.5.0",
    "tailwindcss": "^4.3.3"
  }
}
