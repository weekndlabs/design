{
  "name": "@weekndlabs/design",
  "version": "0.2.0",
  "description": "Design tokens for WeekndLabs products",
  "type": "module",
  "license": "MIT AND OFL-1.1",
  "files": [
    "dist",
    "tokens",
    "README.md",
    "ABOUT.md"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./fonts/*": "./dist/fonts/*",
    "./tailwind": "./dist/tailwind.js",
    ".": "./dist/tokens.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build/index.js",
    "prepublishOnly": "npm run build && npm test",
    "test": "node --test lib/*.test.js",
    "docs:dev": "astro dev --root docs",
    "docs:build": "astro build --root docs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.1.3",
    "style-dictionary": "^5.5.0"
  }
}
