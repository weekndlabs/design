---
import Page from '../layouts/Page.astro';
/**
 * The README, rendered. Not a copy of it: writing the usage docs twice is how
 * one of them ends up wrong, and the README is the version npm and GitHub
 * already show.
 */
import { Content } from '../../../README.md';
/**
 * Prose comes from the package now, not from this file. It lived here until
 * 0.5.0, which meant any other product rendering markdown wrote it again or
 * went without.
 */
import '../../../dist/prose.css';

// Absolute for the same reason every link in SiteChrome.astro is: two hosts,
// and the proxied one serves this page as /design/guide with no trailing slash,
// so relative hrefs resolve somewhere else there.
const DOCS = 'https://weekndlabs.com/design';
---
<Page title="Guide">
  <main id="main" class="wrap wl-prose">
    <p class="back mono"><a href={DOCS}>&larr; Tokens</a></p>
    <Content />
  </main>

  <style>
    main { padding-block: var(--wl-space-8); }
    /* Prose here is full of unbreakable strings: package names, css variables,
       file paths. Without this they set the page's minimum width and a phone
       scrolls sideways. Code blocks and tables scroll themselves instead. */
    .wl-prose { overflow-wrap: break-word; }
    .back { font-size: var(--wl-text-meta); margin-bottom: var(--wl-space-6); }
    .back a { text-decoration: none; }

  </style>
</Page>
