---
import Page from '../layouts/Page.astro';
/**
 * The README, rendered. Not a copy of it: writing the usage docs twice is how
 * one of them ends up wrong, and the README is the version npm and GitHub
 * already show.
 */
import { Content } from '../../../README.md';
---
<Page title="Guide">
  <main id="main" class="wrap prose">
    {/* Relative, not absolute. This page answers on design.weekndlabs.com and
        on weekndlabs.com/design, and `/` would leave the docs entirely on the
        second one.

        `../` rather than `./`: the page is served as the directory /guide/, so
        `./` is this page again. */}
    <p class="back mono"><a href="../">&larr; Tokens</a></p>
    <Content />
  </main>

  <style>
    main { padding-block: var(--wl-space-8); }
    /* Prose here is full of unbreakable strings: package names, css variables,
       file paths. Without this they set the page's minimum width and a phone
       scrolls sideways. Code blocks and tables scroll themselves instead. */
    .prose { overflow-wrap: break-word; }
    .back { font-size: var(--wl-text-fine); margin-bottom: var(--wl-space-6); }
    .back a { text-decoration: none; }

    /* Markdown arrives as bare tags, so the prose styles are selected by
       element rather than by class. Scoped to .prose so nothing else on the
       site inherits them. */
    .prose :global(h1) {
      font-size: var(--wl-text-display);
      letter-spacing: var(--wl-tracking-display);
      margin-bottom: var(--wl-space-5);
    }
    .prose :global(h2) {
      font-size: var(--wl-text-section);
      margin-top: var(--wl-space-8);
      margin-bottom: var(--wl-space-4);
      padding-top: var(--wl-space-5);
      border-top: 1px solid rgb(var(--wl-rule));
    }
    .prose :global(h3) {
      font-size: var(--wl-text-lede);
      margin-top: var(--wl-space-6);
      margin-bottom: var(--wl-space-3);
    }
    .prose :global(p),
    .prose :global(ul),
    .prose :global(ol) {
      max-width: var(--wl-measure-text);
      margin-bottom: var(--wl-space-4);
    }
    .prose :global(li) { margin-bottom: var(--wl-space-2); }
    .prose :global(ul), .prose :global(ol) { padding-left: var(--wl-space-5); }

    /* Inline code is a fragment of the thing being described, so it sits in the
       text. A block is machine output, so it gets the sunken surface. */
    .prose :global(code) {
      font-size: 0.9em;
      background: rgb(var(--wl-surface-sunk));
      border: 1px solid rgb(var(--wl-rule-soft));
      border-radius: var(--wl-radius-sm);
      padding: 1px 5px;
    }
    /* Same treatment the triptych gives its terminal, for the same reason: a
       block of machine output reads the same regardless of the page around it. */
    .prose :global(pre) {
      background: rgb(var(--wl-inset));
      color: rgb(var(--wl-inset-ink));
      border-radius: var(--wl-radius-md);
      padding: var(--wl-space-4);
      margin-bottom: var(--wl-space-5);
      overflow-x: auto;
      font-size: var(--wl-text-fine);
      line-height: var(--wl-leading-mono);
    }
    /* The block already carries the surface; the code inside must not draw a
       second box on top of it. */
    .prose :global(pre code) {
      background: none;
      border: 0;
      padding: 0;
      font-size: inherit;
    }

    .prose :global(table) {
      width: 100%;
      border-collapse: collapse;
      font-size: var(--wl-text-fine);
      margin-bottom: var(--wl-space-5);
    }
    .prose :global(th), .prose :global(td) {
      text-align: left;
      padding: var(--wl-space-2) var(--wl-space-3);
      border-bottom: 1px solid rgb(var(--wl-rule));
      vertical-align: top;
    }
    .prose :global(thead th) {
      font-size: var(--wl-text-eyebrow);
      letter-spacing: var(--wl-tracking-eyebrow);
      text-transform: uppercase;
      color: rgb(var(--wl-ink-soft));
      font-weight: var(--wl-weight-body);
    }
    /* A markdown table has no fixed width and these carry token names and
       ratios, so let the page scroll the table rather than the other way
       round. */
    .prose :global(table) { display: block; overflow-x: auto; }
  </style>
</Page>
