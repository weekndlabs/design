---
import Page from '../layouts/Page.astro';
import Diptych from '../components/Diptych.astro';
import Swatches from '../components/Swatches.astro';
import Scale from '../components/Scale.astro';

/**
 * Absolute, for the reason SiteChrome.astro already gives: the page answers on
 * design.weekndlabs.com and on weekndlabs.com/design, and a relative href means
 * something different depending on which one served it.
 *
 * `./guide/` was tried and is wrong. Next serves the proxied page as /design
 * with no trailing slash, so the browser resolves against / and lands on
 * weekndlabs.com/guide, outside the docs entirely.
 *
 * No trailing slash on the path either: weekndlabs.com/design/guide/ answers
 * 308 to the version without it, so linking with one costs every visitor a
 * redirect.
 */
const DOCS = 'https://weekndlabs.com/design';
---
<Page title="Tokens">
  <main id="main" class="wrap">
    <p class="eyebrow mono">WeekndLabs Design</p>
    <h1>One grammar, two grounds.</h1>
    <p class="lede">
      Omni, Bubo and weekndlabs.com share one neutral ground, one system blue,
      one sans on an optical size axis, and corners that are continuous rather
      than circular. Below is the same card in both themes at once, with the
      measured contrast printed under each.
    </p>
    <p class="guide-link mono">
      <a href={`${DOCS}/components`}>See the components &rarr;</a>
      <a href={`${DOCS}/guide`}>Install and usage &rarr;</a>
    </p>
    <div class="diptych-slot"><Diptych /></div>
    <Swatches />
    <Scale />
  </main>

  <style>
    main { padding-block: var(--wl-space-8); }
    h1 {
      font-size: var(--wl-text-hero);
      letter-spacing: var(--wl-tracking-hero);
      margin-block: var(--wl-space-4);
    }
    .lede {
      color: var(--wl-muted-foreground);
      font-size: var(--wl-text-lede);
      max-width: var(--wl-measure-text);
    }
    .guide-link {
      margin-top: var(--wl-space-5);
      font-size: var(--wl-text-meta);
      display: flex;
      flex-wrap: wrap;
      gap: var(--wl-space-4);
    }
    .guide-link a { text-decoration: none; }
    .diptych-slot { margin-top: var(--wl-space-7); }
  </style>
</Page>
