---
import { THEMES, ROLES, themes } from '../../../dist/tokens.js';
import { contrastRatio } from '../../../lib/contrast.js';

/**
 * The table pairs each role with its surface the same way the gate does, so what
 * the page prints and what the test asserts cannot drift apart. `X-foreground`
 * measures on `X`; `foreground` is the one whose surface is not its own name
 * minus a suffix.
 */
const FOREGROUND = /-foreground(-[a-z]+)?$/;
const MARKS = new Set(['border', 'input', 'ring', ...ROLES.filter((r) => r.startsWith('chart-'))]);

const backdropRole = (role) =>
  role === 'foreground' ? 'background' : role.replace(FOREGROUND, '');

const isText = (role) => role === 'foreground' || FOREGROUND.test(role);

const measure = (theme, role) => {
  if (role === 'radius') return themes[theme].radius;
  if (MARKS.has(role)) return 'mark, exempt';
  if (!isText(role)) return 'surface, exempt';
  return `${contrastRatio(themes[theme][role], themes[theme][backdropRole(role)]).toFixed(2)}:1`;
};
---
{THEMES.map((theme) => (
  <section class="table">
    <h2 id={`theme-${theme}`} class="mono">{theme}</h2>
    <div class="scroll">
      <table>
        <caption class="sr-only">Semantic roles and measured contrast for the {theme} theme</caption>
        <thead>
          <tr><th>Role</th><th>Value</th><th>oklch</th><th>On</th><th>Ratio</th></tr>
        </thead>
        <tbody>
          {ROLES.map((role) => (
            <tr>
              <th scope="row" class="mono">{role}</th>
              <td>
                <span class="chip" style={`background: ${themes[theme][role]}`} aria-hidden="true"></span>
              </td>
              <td class="mono">{themes[theme][role]}</td>
              <td class="mono">{isText(role) ? backdropRole(role) : '—'}</td>
              <td class="mono">{measure(theme, role)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
))}

<style>
  .table { margin-top: var(--wl-space-7); }
  h2 { font-size: var(--wl-text-section); margin-bottom: var(--wl-space-4); }
  /* Scroll the table, never the page. */
  .scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: var(--wl-text-meta); }
  th, td {
    text-align: left;
    padding: var(--wl-space-2) var(--wl-space-3);
    border-bottom: 1px solid var(--wl-border);
    white-space: nowrap;
  }
  thead th {
    font-size: var(--wl-text-label);
    letter-spacing: var(--wl-tracking-label);
    text-transform: uppercase;
    color: var(--wl-muted-foreground);
    font-weight: var(--wl-weight-body);
  }
  /* Row headers are token names, so they are set in mono and take mono's
     weight. Both undo the UA's bold on a th. */
  tbody th { font-weight: var(--wl-weight-mono); }
  .chip {
    display: inline-block;
    width: 28px;
    height: 18px;
    border-radius: var(--wl-radius-control);
    corner-shape: var(--wl-corner-shape);
    border: 1px solid var(--wl-input);
    vertical-align: middle;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
