---
/**
 * The weekndlabs.com navbar and footer, rebuilt on this system's own tokens.
 *
 * The markup is written twice on purpose. weekndlabs.com is React and this site
 * is Astro, which is exactly why the package shares tokens rather than
 * components. Colour, type and spacing come from the same source, so the two
 * stay in step even though the markup does not.
 *
 * Every link is absolute. The page answers on two hosts — design.weekndlabs.com
 * and weekndlabs.com/design — and a relative href would point somewhere
 * different depending on which one served it.
 */
const HOME = 'https://weekndlabs.com';
---
<header class="bar">
  <div class="bar-inner">
    <a class="brand" href={HOME}>
      <img src={`${HOME}/logo.png`} alt="" width="32" height="32" />
      <span>WeekndLabs</span>
    </a>

    <nav class="links" aria-label="Main">
      <a href={`${HOME}/#products`}>Products</a>
      {/* This is the current page, so it is text rather than a link. That also
          avoids guessing whether "here" means /design or the subdomain. */}
      <span class="current" aria-current="page">Design</span>
      <a href={`${HOME}/philosophy`}>Philosophy</a>
    </nav>

    <div class="actions">
      <button type="button" id="theme-toggle" aria-label="Switch theme">
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
      <a class="btn filled" href="https://github.com/sponsors/fajarhide">Sponsor</a>
      <a class="btn outlined" href="https://github.com/weekndlabs">Star on GitHub</a>

      {/* <details> rather than a script: it opens, closes and announces itself
          without any JavaScript, and every link in the panel leaves this page,
          so there is nothing left to close afterwards. */}
      <details class="menu">
        <summary aria-label="Menu">
          <svg class="icon-menu" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18" />
          </svg>
          <svg class="icon-close" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </summary>
        {/* Absolute, not in flow: an in-flow panel would push the page down
            while open, same reason weekndlabs.com places its panel this way. */}
        <div class="panel">
          <a href={`${HOME}/#products`}>Products</a>
          <span class="current" aria-current="page">Design<span class="mark" aria-hidden="true"></span></span>
          <a href={`${HOME}/philosophy`}>Philosophy</a>
          <div class="panel-actions">
            <a class="btn filled" href="https://github.com/sponsors/fajarhide">Sponsor</a>
            <a class="btn outlined" href="https://github.com/weekndlabs">Star on GitHub</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<slot />

<footer class="foot">
  <div class="foot-inner">
    <p class="mono">&copy; 2026 WeekndLabs.</p>
    <p class="mono middle">Built from Indonesia 🇮🇩 shipped to the world.</p>
    <div class="foot-links mono">
      <a class="sponsor" href="https://github.com/sponsors/fajarhide">Sponsor</a>
      <a href="https://github.com/weekndlabs/design">GitHub</a>
      <a href={`${HOME}/philosophy`}>Philosophy</a>
      <a href={`${HOME}/privacy-policy`}>Privacy</a>
      <a href={`${HOME}/terms-of-service`}>Terms</a>
    </div>
  </div>
</footer>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(var(--wl-surface));
    border-bottom: 1px solid rgb(var(--wl-rule));
  }
  .bar-inner {
    max-width: 80rem;
    margin: 0 auto;
    height: 64px;
    padding: 0 var(--wl-space-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--wl-space-4);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--wl-font-night-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: rgb(var(--wl-ink));
    text-decoration: none;
  }
  .brand:hover { color: rgb(var(--wl-accent)); }
  .brand img { border-radius: var(--wl-radius-md); }

  .links { display: none; gap: var(--wl-space-6); align-items: center; }
  .links a, .links .current {
    font-family: var(--wl-font-night-mono);
    font-size: var(--wl-text-fine);
    text-decoration: none;
  }
  .links a, .links .current { border-bottom: 1px solid transparent; }
  .links a { color: rgb(var(--wl-ink-soft)); }
  .links a:hover { color: rgb(var(--wl-ink)); border-bottom-color: rgb(var(--wl-rule)); }
  .links .current { color: rgb(var(--wl-accent)); border-bottom-color: rgb(var(--wl-accent)); }

  .actions { display: flex; align-items: center; gap: var(--wl-space-3); }

  #theme-toggle {
    height: 36px;
    width: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid rgb(var(--wl-rule));
    border-radius: var(--wl-radius-sm);
    color: rgb(var(--wl-ink-soft));
    cursor: pointer;
  }
  #theme-toggle:hover { border-color: rgb(var(--wl-accent)); color: rgb(var(--wl-accent)); }
  /* One icon per theme. Which one shows is decided by data-theme rather than by
     script, so the button is never briefly wrong or briefly empty. */
  .icon-sun, .icon-moon { display: none; }
  :global(html[data-theme='night-dark']) .icon-sun { display: block; }
  :global(html[data-theme='night-light']) .icon-moon { display: block; }

  .btn {
    display: none;
    align-items: center;
    justify-content: center;
    /* A thumb-sized tap target, the same 44px floor weekndlabs.com sets. */
    min-height: 44px;
    font-family: var(--wl-font-night-mono);
    font-size: var(--wl-text-fine);
    text-transform: uppercase;
    padding: 10px var(--wl-space-5);
    border: 1px solid;
    border-radius: var(--wl-radius-sm);
    text-decoration: none;
  }
  .btn.filled {
    background: rgb(var(--wl-accent));
    border-color: rgb(var(--wl-accent));
    color: rgb(var(--wl-surface));
  }
  .btn.filled:hover {
    background: rgb(var(--wl-accent-strong));
    border-color: rgb(var(--wl-accent-strong));
  }
  .btn.outlined {
    background: transparent;
    border-color: rgb(var(--wl-rule));
    color: rgb(var(--wl-ink));
  }
  .btn.outlined:hover { border-color: rgb(var(--wl-accent)); color: rgb(var(--wl-accent)); }

  .foot {
    border-top: 1px solid rgb(var(--wl-rule));
    background: rgb(var(--wl-surface));
    margin-top: var(--wl-space-9);
    padding: var(--wl-space-7) 0;
  }
  .foot-inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 var(--wl-space-5);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--wl-space-5);
    text-align: center;
  }
  .foot p, .foot a { font-size: var(--wl-text-fine); color: rgb(var(--wl-ink-soft)); }
  .foot-links { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--wl-space-5); }
  .foot-links a { text-decoration: none; }
  .foot-links a:hover { color: rgb(var(--wl-ink)); }
  .foot-links a.sponsor { color: rgb(var(--wl-accent)); }

  .menu summary {
    height: 36px;
    width: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(var(--wl-rule));
    border-radius: var(--wl-radius-sm);
    color: rgb(var(--wl-ink-soft));
    cursor: pointer;
    /* Kill the disclosure triangle in both engines. */
    list-style: none;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary:hover { border-color: rgb(var(--wl-accent)); color: rgb(var(--wl-accent)); }
  .menu summary:focus-visible { outline: 2px solid rgb(var(--wl-accent)); outline-offset: 3px; }
  .icon-close { display: none; }
  .menu[open] .icon-menu { display: none; }
  .menu[open] .icon-close { display: block; }

  .panel {
    /* The bar is sticky, so it is the containing block for this. */
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgb(var(--wl-surface-panel));
    border-bottom: 1px solid rgb(var(--wl-rule));
    padding: var(--wl-space-1) var(--wl-space-5) var(--wl-space-4);
    display: flex;
    flex-direction: column;
  }
  .panel a, .panel .current {
    font-family: var(--wl-font-night-mono);
    font-size: var(--wl-text-fine);
    text-decoration: none;
    padding: 14px 0;
    border-bottom: 1px solid rgb(var(--wl-rule-soft));
  }
  .panel a { color: rgb(var(--wl-ink)); }
  .panel a:active { color: rgb(var(--wl-accent)); }
  .panel .current { color: rgb(var(--wl-accent)); }
  /* The buttons below bring their own top rule, so the last link drops its
     bottom one instead of drawing a second line beside it. */
  .panel > a:last-of-type { border-bottom: none; }
  .panel .mark {
    display: block;
    height: 1px;
    width: 32px;
    margin-top: var(--wl-space-2);
    background: rgb(var(--wl-accent));
  }
  .panel-actions {
    display: flex;
    flex-direction: column;
    gap: var(--wl-space-3);
    margin-top: var(--wl-space-4);
    padding-top: var(--wl-space-4);
    border-top: 1px solid rgb(var(--wl-rule));
  }
  .panel-actions .btn { display: inline-flex; width: 100%; }

  @media (min-width: 640px) {
    .brand { font-size: 1.25rem; }
  }
  @media (min-width: 768px) {
    .links { display: flex; }
    .btn.outlined { display: inline-flex; }
    .menu { display: none; }
    .foot-inner { flex-direction: row; justify-content: space-between; align-items: flex-start; text-align: left; }
    .foot-inner .middle { flex-grow: 1; text-align: center; }
  }
  @media (min-width: 1024px) {
    .btn.filled { display: inline-flex; }
  }
</style>
