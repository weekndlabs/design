---
import { THEMES, themes } from '../../../dist/tokens.js';
import { contrastRatio } from '../../../lib/contrast.js';
---
<div class="diptych">
  {THEMES.map((theme) => (
    <section data-theme={theme} class="panel">
      <p class="eyebrow mono">{theme}</p>
      <h3>WeekndLabs</h3>
      <p class="lede">One grammar, two grounds.</p>
      <p class="tags mono"><span>[Tokens]</span><span>[shadcn]</span></p>
      <pre class="terminal mono">$ npm i @weekndlabs/design
<span class="dim">+ @weekndlabs/design@0.4.0</span></pre>
      <p class="ratio mono">
        foreground {contrastRatio(themes[theme].foreground, themes[theme].background).toFixed(2)}:1
      </p>
    </section>
  ))}
</div>

<style>
  /* Fits however many themes THEMES holds. Hardcoding two would mean a third
     theme silently landing in a row of one, or off the grid entirely. */
  .diptych {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--wl-space-4);
  }
  .panel {
    background: var(--wl-background);
    color: var(--wl-foreground);
    border: 1px solid var(--wl-border);
    border-radius: var(--wl-radius-window);
    corner-shape: var(--wl-corner-shape);
    padding: var(--wl-space-5);
  }
  .eyebrow {
    font-size: var(--wl-text-label);
    letter-spacing: var(--wl-tracking-label);
    text-transform: uppercase;
    color: var(--wl-muted-foreground);
  }
  h3 { margin-top: var(--wl-space-3); }
  .lede {
    color: var(--wl-muted-foreground);
    font-size: var(--wl-text-meta);
    margin-top: var(--wl-space-2);
  }
  .tags {
    margin-top: var(--wl-space-3);
    display: flex;
    gap: var(--wl-space-2);
    font-size: var(--wl-text-label);
    color: var(--wl-primary);
  }
  /* Identical in both themes on purpose. A terminal is a terminal whatever the
     page around it does, and one ground is what keeps its palette to a single
     set of ratios. */
  .terminal {
    margin-top: var(--wl-space-4);
    background: var(--wl-terminal-ground);
    color: var(--wl-terminal-foreground);
    border-radius: var(--wl-radius-card);
    corner-shape: var(--wl-corner-shape);
    padding: var(--wl-space-3);
    font-size: var(--wl-text-label);
    line-height: var(--wl-leading-mono);
    overflow-x: auto;
  }
  .terminal .dim { color: var(--wl-terminal-dim); }
  .ratio {
    margin-top: var(--wl-space-4);
    font-size: var(--wl-text-label);
    color: var(--wl-muted-foreground);
  }
  @media (max-width: 860px) {
    .diptych { grid-template-columns: minmax(0, 1fr); }
  }
</style>
