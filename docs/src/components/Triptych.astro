---
import { THEMES, themes } from '../../../dist/tokens.js';
import { contrastRatio } from '../../../lib/contrast.js';
---
<div class="triptych">
  {THEMES.map((theme) => (
    <section data-theme={theme} class="panel">
      <p class="eyebrow mono">{theme}</p>
      <h3>Omni</h3>
      <p class="lede">Noise-canceling context for AI agents.</p>
      <p class="tags mono"><span>[Rust]</span><span>[MCP]</span></p>
      <pre class="terminal mono">$ omni --pre-hook
<span class="dim">saved 4.2k tokens</span></pre>
      <p class="ratio mono">
        foreground {contrastRatio(themes[theme].foreground, themes[theme].background).toFixed(2)}:1
      </p>
    </section>
  ))}
</div>

<style>
  /* Fits however many themes THEMES holds. Hardcoding three would mean a fourth
     theme silently landing in a fourth row of one, or off the grid entirely. */
  .triptych {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--wl-space-4);
  }
  .panel {
    background: var(--wl-background);
    color: var(--wl-foreground);
    border: 1px solid var(--wl-border);
    border-radius: var(--wl-radius);
    padding: var(--wl-space-5);
  }
  .eyebrow {
    font-size: var(--wl-text-label);
    letter-spacing: var(--wl-tracking-label);
    text-transform: uppercase;
    color: var(--wl-muted-foreground);
  }
  h3 { margin-top: var(--wl-space-3); }
  .lede {
    color: var(--wl-muted-foreground);
    font-size: var(--wl-text-meta);
    margin-top: var(--wl-space-2);
  }
  .tags {
    margin-top: var(--wl-space-3);
    display: flex;
    gap: var(--wl-space-2);
    font-size: var(--wl-text-label);
    color: var(--wl-primary);
  }
  /* The terminal is identical in all three themes on purpose: a terminal is a
     terminal regardless of the page around it. */
  .terminal {
    margin-top: var(--wl-space-4);
    background: var(--wl-terminal);
    color: var(--wl-terminal-foreground);
    border-radius: var(--wl-radius);
    padding: var(--wl-space-3);
    font-size: var(--wl-text-label);
    line-height: var(--wl-leading-mono);
    overflow-x: auto;
  }
  .terminal .dim { color: var(--wl-terminal-foreground-muted); }
  .ratio {
    margin-top: var(--wl-space-4);
    font-size: var(--wl-text-label);
    color: var(--wl-muted-foreground);
  }
  @media (max-width: 860px) {
    .triptych { grid-template-columns: minmax(0, 1fr); }
  }
</style>
