---
import SiteChrome from '../components/SiteChrome.astro';
// Imported here rather than @import-ed in the style block below: only this path
// runs the woff2 files through Vite, so they are emitted into _astro/ with the
// hashed names the @font-face rules end up pointing at. An @import leaves the
// urls untouched and the fonts 404.
import '../../../dist/fonts.css';

const { title } = Astro.props;

// Runs before first paint so the page never shows one theme and then flips.
//
// weekndlabs.com stores the visitor's choice under `theme` as 'light' or
// 'dark'. Served at weekndlabs.com/design this page is same-origin with it, so
// that choice is readable here and the two never disagree. On
// design.weekndlabs.com the origin differs and there is nothing to read, which
// is why the OS preference is the fallback rather than a hardcoded default.
const themeScript = `(function(){var t=null;try{t=localStorage.getItem('theme')}catch(e){}
var dark=t?t==='dark':window.matchMedia('(prefers-color-scheme: dark)').matches;
document.documentElement.dataset.theme=dark?'dark':'light'})()`;
---
<!doctype html>
<html lang="en">
  <head>
    <script is:inline set:html={themeScript} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · WeekndLabs Design</title>
    {/* Pointed at weekndlabs.com rather than copied in, the same way
        SiteChrome.astro already loads the brand mark. Copying would mean this
        repo carries a second copy of an icon that has been changed before, and
        the two marks drifting apart is the thing to avoid. */}
    <link rel="icon" href="https://weekndlabs.com/favicon.ico" type="image/x-icon" sizes="48x48" />
    <link rel="icon" href="https://weekndlabs.com/icon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="https://weekndlabs.com/apple-icon.png" type="image/png" sizes="180x180" />
    <meta name="description" content="Design tokens for WeekndLabs products. One grammar, three faces." />
    {/* weekndlabs.com proxies this site at /design, so the same HTML answers on
        two hosts. Name the one that actually serves it. */}
    <link rel="canonical" href={new URL(Astro.url.pathname, 'https://design.weekndlabs.com').href} />
    <style is:global>
      @import '../../../dist/tokens.css';

      *, *::before, *::after { box-sizing: border-box; margin: 0; }

      /* Scrollbars and form controls follow the theme rather than staying dark
         on a light page. */
      html[data-theme='dark'] { color-scheme: dark; }
      html[data-theme='light'] { color-scheme: light; }

      body {
        background: var(--wl-background);
        color: var(--wl-foreground);
        font-family: var(--wl-font-ui-body);
        font-size: 16px;
        font-weight: var(--wl-weight-body);
        line-height: var(--wl-leading-body);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        -webkit-font-smoothing: antialiased;
      }
      /* The footer sits at the bottom on a short page instead of floating
         halfway up. */
      body > main { flex-grow: 1; }

      /* Weight is set rather than left to the UA default: Bricolage ships 600,
         700 and 800, so a browser deciding "bold" for itself is a browser
         picking a weight the font may not have. */
      h1, h2, h3 {
        font-family: var(--wl-font-ui-display);
        font-weight: var(--wl-weight-display);
        letter-spacing: var(--wl-tracking-section);
        line-height: var(--wl-leading-hero);
      }

      code, .mono { font-family: var(--wl-font-ui-mono); }

      /* `width: 100%` is load-bearing. main is a flex item of the body column,
         and an auto horizontal margin cancels the stretch that would otherwise
         size it — leaving it to shrink-to-fit the min-content width of the
         nowrap token tables, so the whole page scrolled sideways on a phone
         instead of the tables scrolling inside themselves. */
      .wrap {
        width: 100%;
        max-width: var(--wl-measure-page);
        margin: 0 auto;
        padding: 0 var(--wl-space-5);
      }

      .eyebrow {
        font-size: var(--wl-text-label);
        letter-spacing: var(--wl-tracking-label);
        text-transform: uppercase;
        color: var(--wl-muted-foreground);
      }

      a { color: var(--wl-primary); }

      a:focus-visible, button:focus-visible {
        outline: 2px solid var(--wl-primary);
        outline-offset: 3px;
      }

      /* Give the skip link somewhere to land without shifting the layout. */
      .skip {
        position: absolute;
        left: var(--wl-space-5);
        top: calc(var(--wl-space-5) * -4);
        background: var(--wl-card);
        border: 1px solid var(--wl-border);
        border-radius: var(--wl-radius);
        padding: var(--wl-space-2) var(--wl-space-4);
        z-index: 1;
      }
      .skip:focus { top: var(--wl-space-4); }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: .01ms !important;
          transition-duration: .01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteChrome>
      <slot />
    </SiteChrome>
    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', function () {
        var root = document.documentElement;
        var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        // Stored as 'light'/'dark' rather than the theme name, so a visitor who
        // toggles here and walks back to weekndlabs.com keeps the same choice.
        try {
          localStorage.setItem('theme', next === 'dark' ? 'dark' : 'light');
        } catch (e) {
          // Safari private mode throws. The theme still applies to this page.
        }
      });
    </script>
  </body>
</html>
